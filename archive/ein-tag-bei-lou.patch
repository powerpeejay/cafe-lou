+  <script>
+  (function(){
+    var sec=document.getElementById('tag');if(!sec)return;
+    if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;
+    var clock=document.getElementById('tag-clock'),stops=[].slice.call(sec.querySelectorAll('.tag-stop')),imgs=[].slice.call(sec.querySelectorAll('.tag-photos img')),now=document.getElementById('tag-now'),cur=0,raf=0;
+    imgs.forEach(function(im){im.loading='eager'});
+    function frame(){raf=0;var r=sec.getBoundingClientRect(),span=sec.offsetHeight-innerHeight,p=Math.min(1,Math.max(0,-r.top/span));
+      sec.style.setProperty('--p',p.toFixed(4));
+      var m=Math.round((540+p*480)/15)*15;clock.textContent=Math.floor(m/60)+':'+String(m%60).padStart(2,'0');
+      var k=0;stops.forEach(function(s,i){if(m>=+s.dataset.t)k=i});
+      if(k!==cur){cur=k;stops.forEach(function(s,i){s.classList.toggle('on',i===k)});imgs.forEach(function(im,i){im.classList.toggle('on',i===k)})}}
+    addEventListener('scroll',function(){if(!raf)raf=requestAnimationFrame(frame)},{passive:true});addEventListener('resize',frame);frame();
+    try{var pr=new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Berlin',weekday:'short',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(new Date());
+      var g=function(t){return pr.find(function(x){return x.type===t}).value},mm=+g('hour')*60+ +g('minute');
+      if(new URLSearchParams(location.search).has('tagdemo'))mm=760;
+      if((g('weekday')!=='Tue'||mm===760)&&mm>=540&&mm<1020){now.style.left=((mm-540)/480*100)+'%';now.textContent='Du bist hier: '+Math.floor(mm/60)+':'+String(mm%60).padStart(2,'0');now.classList.add('show')}}catch(e){}
+  })();
+  </script>
